# Copy to .env.local (never commit real values).

# --- AI provider: gemini (default) or openai ---
AI_PROVIDER=gemini
AI_MAX_OUTPUT_TOKENS=2048

# Gemini (Google AI Studio key — server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the main model is overloaded or out of quota
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768
# Optional thinking budget (older 2.5 models only). Leave empty for the model default.
GEMINI_THINKING_BUDGET=

# OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Usage limits (AI-09) ---
AI_RATE_PER_MINUTE=20
AI_DAILY_LIMIT=1500

# --- Private staging (D13): set both to require a password ---
STAGING_USER=
STAGING_PASSWORD=

# --- Admin dashboard (/admin) ---
ADMIN_PASSWORD=
# Optional: separate signing secret for admin sessions (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Where website reports are saved (default .data/cases.json)
CASES_FILE=

# --- Firebase Realtime Database (website reports) ---
# Server-side Admin SDK. Download a service-account key: Firebase console > Project settings > Service accounts > Generate new private key.
# Save it at the path below (git-ignored). Never paste it into chat or commit it.
FIREBASE_DATABASE_URL=https://aamca-c0678-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_FILE=.secrets/firebase-service-account.json
# Alternative for hosting (e.g. Vercel): the key JSON, or base64 of it, in one variable
FIREBASE_SERVICE_ACCOUNT=

# --- Cloudinary (report photos) — unsigned upload preset, no API secret needed ---
CLOUDINARY_CLOUD_NAME=q1pfgbro
CLOUDINARY_UPLOAD_PRESET=AAMCA project
CLOUDINARY_FOLDER=aacma-reports
